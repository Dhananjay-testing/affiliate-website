---
import { getCollection } from 'astro:content';
import { categories } from '../data/categories';
import { published } from '../lib/content';
import { site } from '../config/site';
import Layout from '../components/Layout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import EditorialCard from '../components/EditorialCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
const allArticles = published(await getCollection('articles'));
const allGuides = published(await getCollection('guides'));
const latestArticles = allArticles.sort((a,b) => b.data.publishDate.valueOf()-a.data.publishDate.valueOf()).slice(0,3);
const featuredGuides = allGuides.slice(0,3);
---
<Layout title="Discover better. Choose smarter." description={site.description}>
  <section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> A little more clarity for everyday choices</p><h1>Good choices<br />start with <em>good questions.</em></h1><p class="hero-description">{site.description} Explore practical ideas, thoughtful comparisons and buying advice made for real life in India.</p><div class="hero-actions"><a class="button button-primary" href="/categories/">Explore categories <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="/guides/">Browse buying guides <span aria-hidden="true">→</span></a></div><div class="hero-note"><span class="note-check">✓</span><span>Independent, useful and transparent recommendations</span></div></div>
    <div class="hero-art" role="img" aria-label="An original illustration of thoughtful everyday product discoveries"><div class="art-backdrop"></div><div class="sun-disc"></div><div class="art-card art-card-one"><span class="mini-label">A better everyday</span><span class="mini-line line-wide"></span><span class="mini-line"></span><span class="mini-line line-short"></span><span class="mini-check">✓</span></div><div class="art-card art-card-two"><span class="art-star">✳</span><span><b>Choice, made clearer.</b><small>Useful guides for life in India</small></span></div><div class="art-plant"><i></i><i></i><i></i><i></i><span></span></div><span class="art-spark spark-one">✦</span><span class="art-spark spark-two">✧</span><div class="art-ground"></div></div>
  </section>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Find your next good idea</p><h2>Explore by category</h2><p class="muted">From everyday tech to kitchen essentials, start with what you need.</p></div><a class="text-link" href="/categories/">All categories <span>↗</span></a></div><div class="category-grid">{categories.filter((category) => category.featured).map((category) => <CategoryCard category={category} />)}</div></section>
  <section class="section section-tint"><div class="wrap"><SectionHeading eyebrow="Make the choice with confidence" title="Buying guides" description="Understand what matters, what to compare and what to skip." link="/guides/" />{featuredGuides.length ? <div class="editorial-grid">{featuredGuides.map((item) => <EditorialCard item={item} label="Buying guide" />)}</div> : <div class="empty-state compact"><span class="empty-icon">✳</span><div><h3>Useful guides are in the works</h3><p>We’re preparing practical, carefully reviewed buying guides. In the meantime, explore a category or browse our article drafts.</p></div><a href="/categories/" class="text-link">Explore categories <span>→</span></a></div>}</div></section>
  <section class="section wrap"><SectionHeading eyebrow="A considered shortlist" title="Product discoveries" description="Recommendations will include clear selection criteria, trade-offs and verified retailer links." link="/products/" linkLabel="Explore products" /><div data-product-feed data-limit="3"><div data-product-list class="product-grid"></div><div class="empty-state product-empty" data-empty-feed><div class="empty-product-icon">⌕</div><div><h3>Good recommendations take a little research</h3><p data-feed-message>We’re reviewing products and verifying retailer links before anything is published. No placeholder listings, invented prices or unverified claims.</p><a href="/affiliate-disclosure/" class="text-link">How recommendations work <span>→</span></a></div></div></div></section>
  <section class="section section-tint"><div class="wrap"><SectionHeading eyebrow="Fresh thinking, useful reading" title="Latest articles" description="Practical ideas for smarter everyday choices." link="/articles/" />{latestArticles.length ? <div class="editorial-grid">{latestArticles.map((item) => <EditorialCard item={item} />)}</div> : <div class="empty-state compact"><span class="empty-icon">▤</span><div><h3>Our first articles are being reviewed</h3><p>Thoughtful original articles are on their way. Browse by category to explore topics we plan to cover.</p></div><a href="/categories/" class="text-link">Browse topics <span>→</span></a></div>}</div></section>
  <section class="trust-band wrap"><div class="trust-mark">✓</div><div><p class="eyebrow">A clear point of view</p><h2>Useful first. Always transparent.</h2><p>We aim to explain how we choose what to recommend, including the trade-offs. Some links may earn a commission; that never changes the price you pay.</p><a href="/editorial-policy/" class="text-link">Read our editorial policy <span>→</span></a></div><div class="trust-links"><a href="/affiliate-disclosure/">How affiliate links work <span>↗</span></a><a href="/about/">More about Pickora <span>↗</span></a></div></section>
</Layout>
<script>import '../scripts/product-feed';</script>
