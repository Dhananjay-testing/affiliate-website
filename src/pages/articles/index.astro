---
import { getCollection } from 'astro:content';
import { published } from '../../lib/content';
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialCard from '../../components/EditorialCard.astro';
const articles = published(await getCollection('articles')).sort((a,b) => b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<Layout title="Articles" description="Useful, original reading for smarter everyday decisions."><div class="wrap page-shell"><Breadcrumbs items={[{ label: 'Articles' }]} /><header class="page-heading"><p class="eyebrow">Ideas for everyday life</p><h1>Articles</h1><p>Original, practical reading across the categories and choices that fill everyday life.</p></header>{articles.length ? <div class="editorial-grid">{articles.map((item) => <EditorialCard item={item} />)}</div> : <section class="empty-state category-empty"><span class="empty-icon">▤</span><div><h2>Our first articles are being reviewed</h2><p>We’re working on useful, original articles across several categories. Nothing will be published until it’s ready to help.</p><a class="text-link" href="/categories/">Browse topics <span>→</span></a></div></section>}</div></Layout>
