---
import { categories } from '../../data/categories';
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<Layout title="Product discoveries" description="Thoughtful product recommendations with clear trade-offs and transparent affiliate links."><div class="wrap page-shell"><Breadcrumbs items={[{ label: 'Products' }]} /><header class="page-heading"><p class="eyebrow">A considered shortlist</p><h1>Product discoveries</h1><p>Recommendations will be selected for real usefulness, with clear criteria and honest limitations.</p></header><div data-product-feed><div data-product-list class="product-grid" aria-live="polite"></div><section class="empty-state category-empty" data-empty-feed><span class="empty-icon">⌕</span><div><h2>Recommendations are being reviewed</h2><p data-feed-message>There are no published product recommendations yet. We’ll only publish products with useful editorial context and verified direct affiliate links.</p><a class="text-link" href="/guides/">Read buying guides <span>→</span></a></div></section></div><section class="related-categories"><h2>Browse product topics</h2><div>{categories.slice(0,6).map((category) => <a href={`/categories/${category.slug}/`}>{category.name}<span>↗</span></a>)}</div></section></div><script>import '../../scripts/product-feed';</script></Layout>
