---
import { getCollection } from 'astro:content';
import { published } from '../../lib/content';
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialCard from '../../components/EditorialCard.astro';
const guides = published(await getCollection('guides')).sort((a,b) => b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<Layout title="Buying guides" description="Practical buying guides to help compare options and choose confidently."><div class="wrap page-shell"><Breadcrumbs items={[{ label: 'Buying guides' }]} /><header class="page-heading"><p class="eyebrow">Think it through</p><h1>Buying guides</h1><p>Understand what matters before you buy, with practical criteria, clear trade-offs and no made-up ratings.</p></header>{guides.length ? <div class="editorial-grid">{guides.map((item) => <EditorialCard item={item} label="Buying guide" />)}</div> : <section class="empty-state category-empty"><span class="empty-icon">↗</span><div><h2>Useful guides are in the works</h2><p>Our original guides are being reviewed before publication. Browse categories to find topics we plan to cover.</p><a class="text-link" href="/categories/">Explore categories <span>→</span></a></div></section>}</div></Layout>
