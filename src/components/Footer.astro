---
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-main"><div class="footer-brand"><a class="brand" href="/"><img src={site.logo} width="40" height="40" alt="" /><span>{site.name}<small>{site.tagline}</small></span></a><p>{site.footerText}</p></div>
    <div><h2>Explore</h2><a href="/categories/">All categories</a><a href="/guides/">Buying guides</a><a href="/articles/">Articles</a><a href="/deals/">Deals</a></div>
    <div><h2>About Pickora</h2><a href="/about/">Our approach</a><a href="/editorial-policy/">Editorial policy</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/contact/">Contact</a></div>
    <div><h2>Policies</h2><a href="/privacy-policy/">Privacy</a><a href="/terms/">Terms of use</a>{site.socials.length > 0 && <><h2 class="footer-social-heading">Follow along</h2>{site.socials.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label} ↗</a>)}</>}</div>
  </div><div class="footer-bottom"><span>© {year} {site.name}. All rights reserved.</span><span class="associate-statement">{site.amazonAssociateStatement}</span></div>
</footer>
