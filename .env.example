# Required before public deployment. Set the final HTTPS production origin, with no path.
# Example format: PUBLIC_SITE_URL=https://your-real-domain.in
PUBLIC_SITE_URL=
# GitHub OAuth settings are server-side Cloudflare Pages variables/secrets.
GITHUB_CLIENT_ID=
GITHUB_OWNER_ID=
GITHUB_OAUTH_CALLBACK_URL=https://affiliate-website-a1v.pages.dev/api/admin/auth/callback
# Set GITHUB_CLIENT_SECRET as a Cloudflare secret; never add it to this file.
AMAZON_ASSOCIATE_TAG=
